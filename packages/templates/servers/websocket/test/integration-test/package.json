    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@asyncapi/generator": "*",
    "cross-env": "^7.0.3",
    "eslint": "^6.8.0",
    "eslint-plugin-jest": "^23.8.2",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-sonarjs": "^0.5.0"
  }
