"const service = module.exports = {};

/**
 * Send the timestamp message to any connected client every second.
 * @param {object} ws WebSocket connection.
 */
service.sendTimeStampMessage = async (ws) => {
  ws.send('Message from the server: Implement here your business logic that sends messages to a client after it connects.');
};

/**
 * Receive echo message from the client.
 * @param {object} ws WebSocket connection.
 * @param {object} options
 * @param {string} options.path The path in which the message was received.
 * @param {object} options.query The query parameters used when connecting to the server.
 * @param {*} options.message The received message.
 */
service.handleEchoMessage = async (ws, { message, path, query }) => {
  ws.send('Message from the server: Implement here your business logic that reacts on messages sent from a client.');
};
"
`;

exports[`WebSocket Servers Integration Tests JavaScript Server generate server for hoppscotch echo: example.js 1`] = `
"const WebSocket = require('ws');
const config = require('./src/lib/config');

// How long the example waits for the answers of the server before it closes a connection.
const WAIT_FOR_ANSWERS_MS = 1000;

/**
 * Connects to the server at a path, prints every message the server sends, sends the given messages and closes the connection.
 *
 * @param {string} path The path of the channel to connect to.
 * @param {string[]} messages The messages to send once connected.
 * @returns {Promise<void>} Resolves when the connection is closed. Rejects when it fails.
 */
function exchangeMessages(path, messages) {
  return new Promise((resolve, reject) => {
    const connection = new WebSocket(\`ws://localhost:\${config.port}\${path}\`);

    connection.on('error', reject);
    connection.on('close', resolve);
    connection.on('message', (data) => {
      console.log(\`\${path} server says:\`, data.toString());
    });
    connection.on('open', () => {
      console.log(\`\${path} connected.\`);
      for (const message of messages) {
        console.log(\`\${path} sending:\`, message);
        connection.send(message);
      }
      setTimeout(() => connection.close(), WAIT_FOR_ANSWERS_MS);
    });
  });
}

async function main() {
  await exchangeMessages('/', [\\"test\\"]);
}

main().catch((error) => {
  // A refused connection has an error code and no message.
  console.error('The example failed. Is the server running?', error.message || error.code);
  process.exitCode = 1;
});
"
`;

exports[`WebSocket Servers Integration Tests JavaScript Server generate server for hoppscotch echo: index.js 1`] = `
"const http = require('node:http');
const { WebSocketServer } = require('ws');
const config = require('../lib/config');
const routes = require('./routes');

const start = () => {
  const server = http.createServer((req, res) => {
    res.writeHead(404);
    res.end('Error: path not found');
  });
  const wss = new WebSocketServer({ noServer: true });

  server.on('upgrade', (req, socket, head) => {
    // URL.parse returns null for a request target that is not a valid URL. Such a request matches no route.
    const url = URL.parse(req.url, 'http://localhost');
    const handler = url && routes.get(url.pathname);

    if (!handler) {
      socket.write('HTTP/1.1 404 Not Found\\\\r\\\\n\\\\r\\\\n');
      socket.destroy();
      return;
    }

    wss.handleUpgrade(req, socket, head, async (ws) => {
      // Without this listener, one invalid frame from a client would stop the whole server.
      ws.on('error', (err) => console.error(err));
      try {
        await handler(ws, { path: url.pathname, query: Object.fromEntries(url.searchParams) });
      } catch (err) {
        console.error(err);
      }
    });
  });

  server.on('error', (err) => {
    console.error(\`The server could not start on port \${config.port}: \${err.message}\`);
    process.exitCode = 1;
  });
  server.listen(config.port, () => {
    console.info(\`Listening on port \${config.port}\`);
  });
};

start();
"
`;

