exports[`WebSocket Servers Integration Tests JavaScript Server generate server for hoppscotch echo: echo.js 1`] = `
"const service = module.exports = {};

/**
 * Send the timestamp message to any connected client every second.
 * @param {object} ws WebSocket connection.
 */
service.sendTimeStampMessage = async (ws) => {
  ws.send('Message from the server: Implement here your business logic that sends messages to a client after it connects.');
};
/**
 * Receive echo message from the client.
 * @param {object} ws WebSocket connection.
 * @param {object} options
 * @param {string} options.path The path in which the message was received.
 * @param {object} options.query The query parameters used when connecting to the server.
 * @param {} options.message The received message.
 */
service.handleEchoMessage = async (ws, { message, path, query }) => {
  ws.send('Message from the server: Implement here your business logic that reacts on messages sent from a client.');
};
"
`;

exports[`WebSocket Servers Integration Tests JavaScript Server generate server for hoppscotch echo: index.html 1`] = `
"<!DOCTYPE html>
<html lang=\\"en\\">
  <head>
    <title>Hoppscotch Echo WebSocket Server</title>
    <meta content=\\"text/html;charset=utf-8\\" http-equiv=\\"Content-Type\\">
    <meta content=\\"utf-8\\" http-equiv=\\"encoding\\">
  </head>

  <body>
    <h1>Open your browser console to see the logs and details of API you can use to talk to the server.</h1>
    <script>
    let connection;

    function displayHelp() {
      console.log('Available channels:')
      console.log('* /');
      console.log('Available commands:')
      console.log('- listen: Establish a connection with the server at a given path.')
      console.log('  Usage: listen(channelName)');
      console.log(\`  Example: listen('/')\`);
      console.log('- send: Send a message to the server at a currently connected path.')
      console.log('  Usage: send(message)');
      console.log(\`  Example: send({ greet: 'Hello from client' })\`);
    }

    function listen(path) {
      const url = new URL(path, 'wss://echo-websocket.hoppscotch.io').toString()
      connection = new WebSocket(url)

      connection.onerror = error => {
        console.log(\`WebSocket error: \${error}\`)
      }

      connection.onopen = () => {
        console.log('Connected to server');
      }

      connection.onmessage = e => {
        console.log('Server says:', e.data)
      }
    }

    function send(message) {
      if (!connection) {
        console.error('You have to call listen(channelName) first. See the list of available commands and below.');
        displayHelp();
        return;
      }
      let msg = message;
      if (typeof msg === 'object') msg = JSON.stringify(msg);
      connection.send(msg);
      console.info('Hint: check out the server logs to see your message.');
    }

    displayHelp();
    </script>
  </body>
</html>
"
`;

exports[`WebSocket Servers Integration Tests JavaScript Server generate server for hoppscotch echo: index.js 1`] = `
"const http = require('node:http');
const { WebSocketServer } = require('ws');
const config = require('../lib/config');
const routes = require('./routes');

const start = () => {
  const server = http.createServer((req, res) => {
    res.writeHead(404);
    res.end('Error: path not found');
  });
  const wss = new WebSocketServer({ noServer: true });

  server.on('upgrade', (req, socket, head) => {
    // URL.parse returns null for a request target that is not a valid URL. Such a request matches no route.
    const url = URL.parse(req.url, 'http://localhost');
    const handler = url && routes.get(url.pathname);

    if (!handler) {
      socket.write('HTTP/1.1 404 Not Found\\\\r\\\\n\\\\r\\\\n');
      socket.destroy();
      return;
    }

    wss.handleUpgrade(req, socket, head, async (ws) => {
      try {
        await handler(ws, { path: url.pathname, query: Object.fromEntries(url.searchParams) });
      } catch (err) {
        console.error(err);
      }
    });
  });

  server.listen(config.port);
  console.info(\`Listening on port \${config.port}\`);
};

start();
"
`;

